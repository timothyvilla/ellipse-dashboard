# --- OKX (read-only API key recommended: no trade/withdraw permissions) ---
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_ACCOUNT_LABEL=okx        # must match trades.account / challenge.account for this OKX account
OKX_SIMULATED=0              # set to 1 for OKX demo / paper-trading accounts
# OKX_API_BASE=https://www.okx.com

# --- Supabase (SERVICE ROLE key — server-side only, never in the React app) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Server day standardization (GMT+3 to match the cTrader design) ---
MT5_SERVER_OFFSET_MIN=180
