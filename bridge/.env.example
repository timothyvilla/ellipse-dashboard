# One-time OKX since-2021 backfill (crypto_bills). Use the SAME read-only OKX key
# and Supabase service role you already set in Vercel for api/cron/okx-sync.mjs.

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# OKX_SIMULATED=1        # only for OKX demo / paper accounts
# OKX_API_BASE=https://www.okx.com

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Closed-trade (deal) sync ────────────────────────────────────────
# Writes closed positions into the app's `trades` table, deduped against the
# manual HTML-statement import on (account, dedup_key).
#
# OFF by default. Before switching it on:
#   1. apply supabase/20260826_ctrader_deal_sync.sql
#   2. run once against a DEMO account and check the rows
#   3. only then point it at a funded account
SYNC_TRADES=0
# How often to page history, ms. Min 60000. The historical endpoint is rate
# limited far harder than the live one, so there is no point going faster.
DEAL_SYNC_MS=300000
# Where the FIRST run backfills from (YYYY-MM-DD). Defaults to 2 years ago.
# Set this to the account's start date to avoid paging empty weeks.
#CTRADER_HISTORY_FROM=2026-03-01
